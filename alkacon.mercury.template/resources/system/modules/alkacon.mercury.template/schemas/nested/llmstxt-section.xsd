<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

    <xsd:include schemaLocation="opencms://opencms-xmlcontent.xsd"/>

    <xsd:element name="LlmsTxtSectionData" type="OpenCmsLlmsTxtSectionData"/>

    <xsd:complexType name="OpenCmsLlmsTxtSectionData">
        <xsd:sequence>
            <xsd:element name="Section" type="OpenCmsSection" minOccurs="0" maxOccurs="unbounded"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="OpenCmsSection">
        <xsd:sequence>
            <xsd:element name="Id" type="OpenCmsString" minOccurs="1" maxOccurs="1"/>
            <xsd:element name="Name" type="OpenCmsString" minOccurs="1" maxOccurs="1"/>
        </xsd:sequence>
        <xsd:attribute name="language" type="OpenCmsLocale" use="optional"/>
    </xsd:complexType>

    <xsd:annotation>
        <xsd:appinfo>
            <resourcebundles>
                <propertybundle name="alkacon.mercury.template.messages" />
            </resourcebundles>
            <FieldSettings>
                <Setting>
                    <PropertyName>Id</PropertyName>
                    <DisplayName><![CDATA[%(key.label.LlmsTxt.Section.Id)]]></DisplayName>
                    <Description><![CDATA[%(key.label.LlmsTxt.Section.Id.help)]]></Description>
                    <Widget>display</Widget>
                    <Search>false</Search>
                    <Synchronization>true</Synchronization>
                </Setting>
                <Setting>
                    <PropertyName>Name</PropertyName>
                    <DisplayName><![CDATA[%(key.label.LlmsTxt.Section.Name)]]></DisplayName>
                    <Description><![CDATA[%(key.label.LlmsTxt.Section.Name.help)]]></Description>
                    <Widget>string</Widget>
                    <WidgetConfig><![CDATA[%(attribute:stringConfigTypo)]]></WidgetConfig>
                    <RuleRegex>.+</RuleRegex>
                    <RuleType>error</RuleType>
                    <Error><![CDATA[%(key.msg.error.notempty)]]></Error>
                </Setting>
            </FieldSettings>
        </xsd:appinfo>
    </xsd:annotation>
</xsd:schema>
