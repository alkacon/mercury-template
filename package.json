{
  "version": "20.0.0",
  "name": "mercury-template",
  "description": "The Alkacon Mercury template for OpenCms.",
  "author": "Alkacon Software GmbH & Co. KG - http://www.alkacon.com",
  "license": "AGPL-3.0",
  "repository": "mercury-template",
  "private": true,
  "devDependencies": {
    "autoprefixer": "^10.4.24",
    "clean-css": "^5.3.3",
    "clean-css-cli": "^5.6.3",
    "copyfiles": "^2.4.1",
    "del-cli": "^7.0.0",
    "glob": "^13.0.1",
    "minimist": "^1.2.8",
    "nodemon": "^3.1.11",
    "npm": "^11.9.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-urlrewrite": "^0.3.0",
    "sass": "1.77.8",
    "vite": "^7.3.1",
    "webpack": "^5.105.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@googlemaps/markerclusterer": "2.6.2",
    "@popperjs/core": "2.11.8",
    "bootstrap": "5.3.8",
    "current-device": "0.10.2",
    "embla-carousel": "7.0.9",
    "embla-carousel-class-names": "7.0.9",
    "fitvids": "2.1.1",
    "flatpickr": "4.6.13",
    "howler": "2.2.4",
    "jquery": "3.7.1",
    "js-cookie": "3.0.5",
    "lazysizes": "5.3.2",
    "maplibre-gl": "5.17.0",
    "masonry-layout": "4.2.2",
    "photoswipe": "5.4.4",
    "shariff": "3.3.0",
    "tinycolor2": "1.6.0"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "nodemonConfig": {
    "delay": "1000"
  },
  "scripts": {
    "vite-proxy": "vite",
    "debug-vite-proxy": "DEBUG=vite:* vite",
    "dist": "npm run css && npm run js",
    "css": "XSRCDIR=template-src/scss/themes XBUILDDIR=build/npm XDEPLOYDIR=/system/modules/alkacon.mercury.theme/css npm run --silent cssg:all",
    "cssi:icons": "sass --source-map --embed-sources --stop-on-error template-src/fork-awesome/scss:$XBUILDDIR/1_processed",
    "cssg:all": "npm run cssg:clean && npm run cssg:sass && npm run cssi:icons && npm run cssg:postcss && npm run cssg:minify && npm run cssg:deploy",
    "cssg:plugins": "cleancss --source-map --source-map-inline-sources --output $XBUILDDIR/1_processed/base.css template-src/fork-awesome/css/fork-awesome.css",
    "cssg:clean": "del-cli $XBUILDDIR/1_processed/* $XBUILDDIR/2_postcssed/* $XBUILDDIR/3_minified/*",
    "cssg:sass": "sass --source-map --embed-sources --stop-on-error --load-path='../' $XSRCDIR:$XBUILDDIR/1_processed",
    "cssg:postcss": "postcss --config ./npm_scripts/postcss.config.js $XBUILDDIR/1_processed/*.css --dir $XBUILDDIR//2_postcssed",
    "cssg:minify": "node ./npm_scripts/cleancss.js --cleancss --inputDir $XBUILDDIR/2_postcssed/ --outputDir $XBUILDDIR//3_minified",
    "cssg:deploy": "${OCDEPLOY:-copyfiles -f -V} $XBUILDDIR/3_minified/* ${OCMOUNT}$XDEPLOYDIR",
    "js": "npm run js:clean && npm run js:compile && npm run js:deploy",
    "js:clean": "del-cli build/npm/js/*",
    "js:compile": "webpack --config ./npm_scripts/webpack.config.js",
    "js:deploy": "${OCDEPLOY:-copyfiles -f -V} build/npm/js/* ${OCMOUNT}/system/modules/alkacon.mercury.theme/js",
    "watch": "npm run watch:js & npm run watch:css",
    "watch:js": "nodemon --watch template-src/js --ext js --exec \"npm run js\"",
    "watch:css": "nodemon --watch template-src --ext scss --exec \"npm run css\""
  }
}
